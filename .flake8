[flake8]
max-line-length = 129
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    migrations,
    staticfiles,
    static,
    media
ignore =
    E203,
    W503
per-file-ignores =
    manage.py: E402
    diamed/__init__.py: F401
    diamed/settings_local.py: F403,F405
max-complexity = 10
docstring-convention = pep257
