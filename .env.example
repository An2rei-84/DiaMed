#USE_REDIS_CACHE=True

# Email (по умолчанию письма выводятся в консоль)
#EMAIL_BACKEND=smtp
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=user
#EMAIL_HOST_PASSWORD=pass
#DEFAULT_FROM_EMAIL=noreply@diamed.example.com

# Docker-образ для серверного деплоя (нужно в .env НА СЕРВЕРЕ, рядом с docker-compose.yml)
#DIAMED_IMAGE=your-dockerhub-username/diamed:latest

# CI/CD и Docker Registry (опционально)
#DOCKER_USERNAME=your-dockerhub-username
#DOCKER_PASSWORD=your-dockerhub-token
#DEPLOY_HOST=your-server.com
#DEPLOY_USER=deploy
#DEPLOY_KEY=your-ssh-key

# Codecov (опционально для отчетов о покрытии)
#CODECOV_TOKEN=your-codecov-token
